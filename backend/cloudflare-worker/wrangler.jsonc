/**
 * Abinaya Garments chat API: Cloudflare Python Worker.
 * Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * `vars` below are the PRODUCTION values. For local development, `.dev.vars` (git-ignored,
 * copy from .dev.vars.example) overrides them and also holds secrets.
 * Production secrets are set with `npx wrangler secret put <NAME>`, never in this file.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "abinaya-chat-api",
  "main": "src/main.py",
  // >= 2026-11-17 enables request.signal (client-disconnect detection, needed in Phase 8).
  "compatibility_date": "2026-11-23",
  "compatibility_flags": ["python_workers"],
  "observability": { "enabled": true },
  "vars": {
    "ENVIRONMENT": "production",
    // Exact browser origins allowed to call the API (comma-separated, no wildcards).
    "ALLOWED_ORIGINS": "https://abinayagarment.dentcare-demo.workers.dev",
    // Hostnames a Turnstile token may come from (checked against siteverify's "hostname").
    "TURNSTILE_ALLOWED_HOSTNAMES": "abinayagarment.dentcare-demo.workers.dev",
    "MAX_BODY_BYTES": "32768",
    "MAX_MESSAGE_CHARS": "1000",
    "MAX_HISTORY_MESSAGES": "10",
    "SESSION_TTL_SECONDS": "900",
    "GEMINI_MODEL": "gemini-3.5-flash-lite",
    "GEMINI_MAX_OUTPUT_TOKENS": "1024",
    "SEARCH_TOP_K": "4",
    // Chunks scoring below this cosine similarity are ignored (calibrated in Phase 3:
    // lowest correct match 0.619, highest off-topic question 0.596).
    "SEARCH_MIN_SCORE": "0.60",
    // Requests allowed per 60-second window.
    "RATE_LIMIT_SESSION_IP": "5",
    "RATE_LIMIT_CHAT_IP": "20",
    "RATE_LIMIT_CHAT_SESSION": "8"
  },
  // Knowledge index (read-only from the Worker; written by `python -m indexer sync`).
  // Vectorize has no local simulation, so `pywrangler dev` uses the real index remotely.
  "vectorize": [
    { "binding": "VECTORIZE", "index_name": "abinaya-kb", "remote": true }
  ],
  // Exact per-key rate limiting: one RateLimiter Durable Object per key (e.g. "chat-ip:<ip>").
  // (The Workers Rate Limiting binding never blocks on live workers.dev: workers-sdk#16097.)
  "durable_objects": {
    "bindings": [{ "name": "RATE_LIMITER", "class_name": "RateLimiter" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RateLimiter"] }]
}
