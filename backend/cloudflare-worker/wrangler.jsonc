/**
 * Abinaya Garments chat API: Cloudflare Python Worker.
 * Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * `vars` below are the PRODUCTION values. For local development, `.dev.vars` (git-ignored,
 * copy from .dev.vars.example) overrides them and also holds secrets.
 * Production secrets are set with `npx wrangler secret put <NAME>`, never in this file.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "abinaya-chat-api",
  "main": "src/main.py",
  // >= 2026-11-17 enables request.signal (client-disconnect detection, needed in Phase 8).
  "compatibility_date": "2026-11-23",
  "compatibility_flags": ["python_workers"],
  "observability": { "enabled": true },
  "vars": {
    "ENVIRONMENT": "production",
    // Exact browser origins allowed to call the API (comma-separated, no wildcards).
    "ALLOWED_ORIGINS": "https://abinayagarment.dentcare-demo.workers.dev",
    "MAX_BODY_BYTES": "32768",
    "MAX_MESSAGE_CHARS": "1000",
    "MAX_HISTORY_MESSAGES": "10",
    "SESSION_TTL_SECONDS": "900",
    "GEMINI_MODEL": "gemini-3.5-flash-lite",
    "GEMINI_MAX_OUTPUT_TOKENS": "1024",
    "SEARCH_TOP_K": "4"
  }
}
