# Local development overrides for `uv run pywrangler dev`.
# Copy to .dev.vars (git-ignored). Values here override `vars` in wrangler.jsonc locally.

ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cloudflare's Turnstile test secret below reports hostname "example.com".
TURNSTILE_ALLOWED_HOSTNAMES=example.com

# --- Secrets (never commit real values) ---
GEMINI_API_KEY=
# Cloudflare's official test secret: accepts any token (local development only).
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SIGNING_KEY=
