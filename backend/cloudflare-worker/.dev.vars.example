# Local development overrides for `uv run pywrangler dev`.
# Copy to .dev.vars (git-ignored). Values here override `vars` in wrangler.jsonc locally.

ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Secrets (added in later phases; never commit real values) ---
# Phase 4: GEMINI_API_KEY=
# Phase 6: SESSION_SIGNING_KEY=   (generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))")
# Phase 6: TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA   (Cloudflare dummy "always passes" key)
