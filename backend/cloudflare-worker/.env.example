# Operator-only settings for the offline knowledge indexer (python -m indexer).
# Copy to .env (git-ignored). Never deployed, never shared with the Worker or frontend.

# Phase 2: Gemini key used to embed knowledge documents (separate from the Worker's key)
GEMINI_API_KEY=

# Phase 3: Cloudflare credentials, token scoped to "Vectorize Write" only
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
